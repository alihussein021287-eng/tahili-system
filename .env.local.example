# مثال محلي فقط: انسخ هذا الملف إلى .env واستبدل جميع قيم change-me قبل التشغيل
# لا تستخدم كلمات مرور أو بيانات من بيئة حقيقية
# لكل نسخة اسم مشروع مستقل عبر الخيار -p ومنفذ مختلف مثل 3000 أو 3001
# tahili-original: قيم هذه النسخة فقط
APP_PORT=3000
NEXTAUTH_SECRET=change-me-tahili-original-secret-at-least-32-characters
# tahili-dev: استبدل السطرين أعلاه في ملف .env الخاص بها بهذين السطرين بعد إزالة التعليق
# APP_PORT=3001
# NEXTAUTH_SECRET=change-me-tahili-dev-secret-at-least-32-characters
# ولّد سراً عشوائياً مستقلاً لكل نسخة؛ يجب ألا تتساوى قيمتا NEXTAUTH_SECRET أبداً
# تفعيل صريح للوصول المحلي؛ التعطيل هو القيمة الافتراضية في ملف Compose
TAHILI_LOCAL_ACCESS=true
# عطّل الإعداد الأولي بعد إنشاء حساب الإدارة
ALLOW_INITIAL_SETUP=true

# بيانات قاعدة البيانات المحلية؛ استخدم حروفاً وأرقاماً وشرطات لتجنب محارف رابط الاتصال
DB_USER=change-me-db-user
DB_PASSWORD=change-me-db-password
DB_NAME=change-me-db-name

# أسرار وهمية: استبدلها بقيم عشوائية قوية وخاصة بكل نسخة
ADMIN_INITIAL_PASSWORD=change-me-admin-password
REMINDER_KEY=change-me-reminder-key

# بيانات التخزين المحلية
MINIO_USER=change-me-minio-user
MINIO_PASSWORD=change-me-minio-password
COLLABORATION_MINIO_BUCKET=change-me-collaboration
