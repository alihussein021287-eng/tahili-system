logging {
  level  = "info"
  format = "logfmt"
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
  external_labels = { service = "tahili-frontend", environment = "development" }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}

otelcol.processor.attributes "trace_privacy" {
  action {
    key    = "http.target"
    action = "delete"
  }
  action {
    key    = "http.url"
    action = "delete"
  }
  action {
    key    = "url.full"
    action = "delete"
  }
  action {
    key    = "url.query"
    action = "delete"
  }
  action {
    key    = "http.request.header.authorization"
    action = "delete"
  }
  action {
    key    = "http.request.header.cookie"
    action = "delete"
  }
  action {
    key    = "db.statement"
    action = "delete"
  }
  action {
    key    = "db.query.text"
    action = "delete"
  }
  action {
    key    = "exception.message"
    action = "delete"
  }
  action {
    key    = "exception.stacktrace"
    action = "delete"
  }
  action {
    key    = "user.id"
    action = "delete"
  }
  action {
    key    = "client.address"
    action = "delete"
  }
  output { traces = [otelcol.exporter.otlp.tempo.input] }
}

otelcol.receiver.otlp "internal" {
  grpc {}
  http {}

  output {
    traces = [otelcol.processor.attributes.trace_privacy.input]
  }
}

faro.receiver "local" {
  server {
    listen_address = "0.0.0.0"
    listen_port = 12347
    cors_allowed_origins = ["http://192.168.17.20:3000", "https://tahili.elaqat.site"]
  }
  output {
    logs = [loki.write.local.receiver]
  }
}
