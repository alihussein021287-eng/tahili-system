{
  "uid": "tahili-frontend-observability",
  "title": "Frontend Observability",
  "tags": ["tahili", "faro", "local-only"],
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {"id":1,"type":"stat","title":"Alloy receiver target","datasource":{"type":"prometheus","uid":"Prometheus"},"gridPos":{"x":0,"y":0,"w":4,"h":4},"targets":[{"expr":"up{job=\"alloy\"}","refId":"A"}],"fieldConfig":{"defaults":{"mappings":[{"type":"value","options":{"0":{"text":"Down","color":"red"},"1":{"text":"Up","color":"green"}}}]}}},
    {"id":2,"type":"stat","title":"Loki sent entries","datasource":{"type":"prometheus","uid":"Prometheus"},"gridPos":{"x":4,"y":0,"w":4,"h":4},"targets":[{"expr":"sum(loki_write_sent_entries_total{component_id=\"loki.write.local\"})","refId":"A"}]},
    {"id":3,"type":"stat","title":"Dropped / retries","datasource":{"type":"prometheus","uid":"Prometheus"},"gridPos":{"x":8,"y":0,"w":4,"h":4},"targets":[{"expr":"sum(loki_write_dropped_entries_total{component_id=\"loki.write.local\"}) + sum(loki_write_batch_retries_total{component_id=\"loki.write.local\"})","refId":"A"}]},
    {"id":4,"type":"timeseries","title":"Frontend signals by kind","datasource":{"type":"loki","uid":"Loki"},"gridPos":{"x":0,"y":4,"w":12,"h":8},"targets":[{"expr":"sum(count_over_time({service=\"tahili-frontend\"} | logfmt | kind=~\"event|log|measurement\" [$__interval])) by (kind)","refId":"A","legendFormat":"{{kind}}"}],"links":[{"title":"Explore sanitized frontend signals","url":"/explore?left=%7B%22datasource%22:%22Loki%22,%22queries%22:%5B%7B%22expr%22:%22%7Bservice%3D%5C%22tahili-frontend%5C%22%7D%20%7C%20logfmt%22%7D%5D%7D","targetBlank":false}]},
    {"id":5,"type":"timeseries","title":"Frontend logs by level","datasource":{"type":"loki","uid":"Loki"},"gridPos":{"x":12,"y":4,"w":12,"h":8},"targets":[{"expr":"sum(count_over_time({service=\"tahili-frontend\"} | logfmt | kind=\"log\" [$__interval])) by (level)","refId":"A","legendFormat":"{{level}}"}]},
    {"id":6,"type":"timeseries","title":"LCP p95","description":"Milliseconds; sanitized route field only.","datasource":{"type":"loki","uid":"Loki"},"gridPos":{"x":0,"y":12,"w":12,"h":8},"targets":[{"expr":"quantile_over_time(0.95, {service=\"tahili-frontend\"} | logfmt | kind=\"measurement\" | type=\"LCP\" | unwrap value [$__interval])","refId":"A","legendFormat":"p95 LCP"}]},
    {"id":7,"type":"table","title":"Slowest normalized routes (LCP)","datasource":{"type":"loki","uid":"Loki"},"gridPos":{"x":12,"y":12,"w":12,"h":8},"targets":[{"expr":"topk(10, avg_over_time({service=\"tahili-frontend\"} | logfmt | kind=\"measurement\" | type=\"LCP\" | unwrap value [$__interval]) by (page_url))","refId":"A","legendFormat":"{{page_url}}"}]},
    {"id":8,"type":"logs","title":"Recent sanitized frontend signals","datasource":{"type":"loki","uid":"Loki"},"gridPos":{"x":0,"y":20,"w":24,"h":8},"targets":[{"expr":"{service=\"tahili-frontend\"} | logfmt","refId":"A"}],"options":{"showTime":true,"wrapLogMessage":true,"sortOrder":"Descending"}},
    {"id":9,"type":"timeseries","title":"Receiver ingress counters","datasource":{"type":"prometheus","uid":"Prometheus"},"gridPos":{"x":0,"y":28,"w":12,"h":8},"targets":[{"expr":"faro_receiver_events_total","refId":"A","legendFormat":"events"},{"expr":"faro_receiver_logs_total","refId":"B","legendFormat":"logs"},{"expr":"faro_receiver_measurements_total","refId":"C","legendFormat":"measurements"}]},
    {"id":10,"type":"text","title":"Coverage and privacy","gridPos":{"x":12,"y":28,"w":12,"h":8},"options":{"mode":"markdown","content":"**Local-only pipeline**: Browser → same-origin adapter → Alloy → Loki.\\n\\nNo raw URL, query, user, patient, cookie, header, body, stack, or identifier is a metric label. Counters are in-memory and reset when app restarts.\\n\\nTelemetry-absence alert is gated by `tahili_faro_enabled=1` and a 15-minute warm-up; disabled Faro never alerts."}},
    {"id":11,"type":"stat","title":"Faro runtime enabled","datasource":{"type":"prometheus","uid":"Prometheus"},"gridPos":{"x":0,"y":36,"w":4,"h":4},"targets":[{"expr":"tahili_faro_enabled","refId":"A"}]},
    {"id":12,"type":"stat","title":"Seconds since last forwarded telemetry","datasource":{"type":"prometheus","uid":"Prometheus"},"gridPos":{"x":4,"y":36,"w":8,"h":4},"targets":[{"expr":"time() - tahili_faro_last_forwarded_timestamp_seconds","refId":"A"}]},
    {"id":13,"type":"timeseries","title":"Adapter rejection and forwarding failure rates","datasource":{"type":"prometheus","uid":"Prometheus"},"gridPos":{"x":12,"y":36,"w":12,"h":4},"targets":[{"expr":"sum by (reason) (rate(tahili_faro_rejected_total[5m]))","refId":"A","legendFormat":"rejected {{reason}}"},{"expr":"sum by (reason) (rate(tahili_faro_forward_failures_total[5m]))","refId":"B","legendFormat":"forward {{reason}}"}]},
    {"id":14,"type":"timeseries","title":"Frontend error log rate","datasource":{"type":"prometheus","uid":"Prometheus"},"gridPos":{"x":0,"y":40,"w":12,"h":6},"targets":[{"expr":"sum(rate(tahili_faro_frontend_logs_total{level=\"error\"}[5m]))","refId":"A","legendFormat":"error logs/sec"}]},
    {"id":15,"type":"timeseries","title":"LCP histogram p50 / p95","datasource":{"type":"prometheus","uid":"Prometheus"},"gridPos":{"x":12,"y":40,"w":12,"h":6},"targets":[{"expr":"histogram_quantile(0.5, sum by (le) (rate(tahili_faro_lcp_milliseconds_bucket[5m])))","refId":"A","legendFormat":"p50"},{"expr":"histogram_quantile(0.95, sum by (le) (rate(tahili_faro_lcp_milliseconds_bucket[5m])))","refId":"B","legendFormat":"p95"}]}
  ]
}
