[Unit]
Description=Tahili scheduled read-only smoke test (development)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/tahili-system
Environment=TAHILI_SMOKE_ENABLED=false
Environment=TAHILI_SMOKE_RESULT_DIR=/var/lib/tahili-smoke/results
Environment=TAHILI_SMOKE_METRICS_DIR=/var/lib/tahili-smoke/metrics
EnvironmentFile=-/etc/tahili/smoke.env
ExecCondition=/bin/sh -ec 'test "${TAHILI_SMOKE_ENABLED}" = true'
ExecStartPre=/usr/bin/install -d -m 0700 /run/tahili /var/lib/tahili-smoke/results /var/lib/tahili-smoke/metrics
ExecStart=/usr/bin/timeout 10m /tahili-system/scripts/run-readonly-smoke-locked.sh
SuccessExitStatus=75
TimeoutStartSec=11min
CPUQuota=20%
MemoryMax=512M
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ReadWritePaths=/run/tahili /var/lib/tahili-smoke
StandardOutput=journal
StandardError=journal
